{
  "name": "faas-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hot-loadable module platform demo (workspace root)",
  "scripts": {
    "dev": "vite-node apps/server/src/dev.ts",
    "build:modules": "vite-node apps/server/src/build.ts",
    "build:server": "node scripts/build-server.mjs",
    "build": "pnpm build:modules && pnpm build:server",
    "start": "node dist/server/index.js",
    "typecheck": "pnpm -r typecheck"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vite-node": "^6.0.0"
  }
}

# 环境变量示例（复制成 .env 并填入真实值；.env 不会进仓库）
#
# 运行时读取顺序：进程环境变量 > .env（index.ts 启动时用 process.loadEnvFile 加载）

# ── 项目 / 部署 ───────────────────────────────────────────────────────────────
# 项目名，决定 OSS key 前缀的第一段
PROJECT_NAME=faas-demo

# 部署根目录，默认 process.cwd()
# APP_ROOT=/srv/faas

# 产物来源：oss（从 OSS 拉取）/ dir（直接用本地已有产物）
MODULES_SOURCE=oss

# 热区目录；默认 <ROOT>/apps/server/src/modules。
# 远端模式下建议指到一个可写的缓存目录，例如 /var/cache/faas/modules
# MODULES_DIR=/var/cache/faas/modules

# 产物目录（bundle + manifest.json + manifest.prev.json），默认 <ROOT>/dist/modules
# MODULES_DIST_DIR=/var/cache/faas/modules

# ── 服务 ─────────────────────────────────────────────────────────────────────
# PORT=3000
# 所有 controller 的全局挂载前缀，默认 /api；设为空字符串表示挂在根路径
# BASE_PATH=/api

# 轮询间隔（毫秒），默认 30000；设为 0 表示只靠 webhook 触发
# REMOTE_POLL_MS=30000
# 轮询失败后的退避上限（毫秒），默认 300000
# REMOTE_POLL_MAX_MS=300000
# 并发下载数，默认 4
# REMOTE_CONCURRENCY=4

# 同步成功后是否清理本地缓存里的过期产物（默认 true）
# PRUNE_ON_SYNC=true
# 本地缓存保留几代（current + N-1），默认 2；1 表示不留上一版（无法回滚）
# KEEP_GENERATIONS=2

# 设置后 /__admin/* 需要 Authorization: Bearer <token>
# ADMIN_TOKEN=

# ── 阿里云 OSS（发布 + 远端拉取共用）─────────────────────────────────────────
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=your-bucket
# 自定义 endpoint；不填则用 region 推导
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_SECURE=true
OSS_REQUEST_TIMEOUT_MS=30000

# 上传时的并发数（脚本用）
# OSS_UPLOAD_CONCURRENCY=4

# ── 以下键当前版本未读取，保留以便以后扩展 ───────────────────────────────────
# 公开访问域名（未来可绕开签名直连 CDN）
# OSS_PUBLIC_BASE_URL=
# 签名算法版本（ali-oss 默认即可）
# OSS_SIGNATURE_VERSION=v4
# 失败重试次数（ali-oss 默认即可）
# OSS_MAX_RETRIES=3
